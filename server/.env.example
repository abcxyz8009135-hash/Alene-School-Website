DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alene_hs?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/alene_hs?schema=public"
PORT=4000
JWT_SECRET="change-this-to-a-long-random-secret"
NODE_ENV="development"

# Extra browser origins allowed to call the API (comma-separated, no trailing
# slash). The production site https://alene-highschool-website.vercel.app is
# always allowed. In development any http://localhost:<port> is allowed.
CLIENT_ORIGINS=""
# Vercel preview deployments of this project (<name>-*.vercel.app) are allowed
# unless ALLOW_VERCEL_PREVIEWS=false. Change the name if the project is renamed.
VERCEL_PROJECT_NAME="alene-highschool-website"
ALLOW_VERCEL_PREVIEWS="true"
